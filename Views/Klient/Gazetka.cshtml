@model IEnumerable<Proejkt_magazyn.Models.Produkt>

<style>
    .input-ilosc::-webkit-outer-spin-button,
    .input-ilosc::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .input-ilosc {
        -moz-appearance: textfield;
    }
</style>

<div class="container-fluid mt-4">

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }
    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="row mb-4">
                <div class="col-12">
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-primary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="wyszukiwarka" class="form-control border-start-0" placeholder="Szukaj produktu po nazwie lub kodzie EAN..." oninput="filtrujProdukty()">
                    </div>
                </div>
            </div>

            <h3 class="fw-bold text-danger mb-3"><i class="bi bi-tags-fill"></i> Oferta Gazetkowa</h3>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-5">
                @foreach (var item in Model.Where(p => p.CzyGazetka))
                {
                <div class="col produkt-karta" data-nazwa="@item.Nazwa.ToLower()" data-kod="@item.KodKreskowy.ToLower()">
                    <div class="card h-100 shadow-sm border-danger">
                        <div class="card-header bg-danger text-white fw-bold text-center">HIT CENOWY</div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold">@item.Nazwa</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-upc-scan"></i> @item.KodKreskowy | <i class="bi bi-box-seam"></i> @item.WagaKg kg</p>

                            <div class="mb-3">
                                @if (item.StanMagazynowy > 20)
                                {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-2 py-1"><i class="bi bi-box-seam me-1"></i> Dostępne: @item.StanMagazynowy szt.</span>
                                }
                                else if (item.StanMagazynowy > 0)
                                {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning rounded-pill px-2 py-1"><i class="bi bi-exclamation-triangle me-1"></i> Ostatnie: @item.StanMagazynowy szt.</span>
                                }
                                else
                                {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger rounded-pill px-2 py-1"><i class="bi bi-x-circle me-1"></i> Brak towaru</span>
                                }
                            </div>

                            <div class="mt-auto">
                                <h4 class="text-success fw-bold mb-0">@item.CenaBrutto.ToString("0.00") zł</h4>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            <button class="btn btn-outline-danger w-100 fw-bold" onclick="dodajDoKoszyka(@item.Id, '@item.Nazwa.Replace("'", "\\'")', @item.CenaBrutto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), true, @item.StanMagazynowy)" @(item.StanMagazynowy <= 0 ? "disabled" : "")>
                                <i class="bi bi-plus-lg"></i> Dodaj
                            </button>
                        </div>
                    </div>
                </div>
                }
            </div>

            <h3 class="fw-bold text-primary mb-3"><i class="bi bi-boxes"></i> Asortyment Standardowy</h3>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                @foreach (var item in Model.Where(p => !p.CzyGazetka))
                {
                <div class="col produkt-karta" data-nazwa="@item.Nazwa.ToLower()" data-kod="@item.KodKreskowy.ToLower()">
                    <div class="card h-100 shadow-sm border-primary">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold">@item.Nazwa</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-upc-scan"></i> @item.KodKreskowy | <i class="bi bi-box-seam"></i> @item.WagaKg kg</p>

                            <div class="mb-3">
                                @if (item.StanMagazynowy > 20)
                                {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-2 py-1"><i class="bi bi-box-seam me-1"></i> Dostępne: @item.StanMagazynowy szt.</span>
                                }
                                else if (item.StanMagazynowy > 0)
                                {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning rounded-pill px-2 py-1"><i class="bi bi-exclamation-triangle me-1"></i> Ostatnie: @item.StanMagazynowy szt.</span>
                                }
                                else
                                {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger rounded-pill px-2 py-1"><i class="bi bi-x-circle me-1"></i> Brak towaru</span>
                                }
                            </div>

                            <div class="mt-auto">
                                <h5 class="text-dark fw-bold mb-0">@item.CenaBrutto.ToString("0.00") zł</h5>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            <button class="btn btn-outline-primary w-100 fw-bold" onclick="dodajDoKoszyka(@item.Id, '@item.Nazwa.Replace("'", "\\'")', @item.CenaBrutto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), false, @item.StanMagazynowy)" @(item.StanMagazynowy <= 0 ? "disabled" : "")>
                                <i class="bi bi-plus-lg"></i> Dodaj
                            </button>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-dark sticky-top" style="top: 20px;">
                <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text"></i> Dokument WZ</span>
                    <span class="badge bg-light text-dark" id="koszykSumaSztuk">0 szt.</span>
                </div>
                <div class="card-body p-0" style="max-height: 60vh; overflow-y: auto;">
                    <div class="p-3 bg-light border-bottom fw-bold text-danger"><i class="bi bi-tags-fill"></i> ZAMÓWIENIE Z GAZETKI</div>
                    <ul class="list-group list-group-flush" id="listaGazetkowa"></ul>

                    <div class="p-3 bg-light border-bottom fw-bold text-primary"><i class="bi bi-box-seam"></i> ZAMÓWIENIE NORMALNE</div>
                    <ul class="list-group list-group-flush" id="listaNormalna"></ul>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                        <span>Suma brutto:</span>
                        <span id="koszykSumaCena" class="text-success">0.00 zł</span>
                    </div>
                    <form asp-action="ZlozZamowienie" method="post" id="formularzZamowienia">
                        <div id="ukrytePola"></div>
                        <button type="submit" class="btn btn-success w-100 fw-bold btn-lg" id="btnZlozZamowienie" disabled>
                            WYŚLIJ ZAMÓWIENIE
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let koszyk = [];

    function filtrujProdukty() {
        let fraza = document.getElementById('wyszukiwarka').value.toLowerCase();
        let karty = document.querySelectorAll('.produkt-karta');

        karty.forEach(karta => {
            let nazwa = karta.getAttribute('data-nazwa');
            let kod = karta.getAttribute('data-kod');

            if (nazwa.includes(fraza) || kod.includes(fraza)) {
                karta.style.display = '';
            } else {
                karta.style.display = 'none';
            }
        });
    }

    function dodajDoKoszyka(id, nazwa, cena, czyGazetka, maxIlosc) {
        let produkt = koszyk.find(p => p.id === id);
        if (produkt) {
            if (produkt.ilosc < maxIlosc) {
                produkt.ilosc++;
            } else {
                alert(`Osiągnięto limit dostępności! Maksymalnie: ${maxIlosc} szt.`);
            }
        } else {
            if (maxIlosc > 0) {
                koszyk.push({ id: id, nazwa: nazwa, cena: cena, czyGazetka: czyGazetka, ilosc: 1, maxIlosc: maxIlosc });
            }
        }
        odswiezKoszyk();
    }

    function zmienIlosc(id, zmiana) {
        let produkt = koszyk.find(p => p.id === id);
        if (produkt) {
            let nowaIlosc = produkt.ilosc + zmiana;

            if (nowaIlosc > produkt.maxIlosc) {
                alert(`Osiągnięto limit dostępności! Maksymalnie: ${produkt.maxIlosc} szt.`);
                produkt.ilosc = produkt.maxIlosc;
            } else {
                produkt.ilosc = nowaIlosc;
            }

            if (produkt.ilosc <= 0) {
                koszyk = koszyk.filter(p => p.id !== id);
            }
        }
        odswiezKoszyk();
    }

    function ustawIlosc(id, nowaIlosc) {
        let produkt = koszyk.find(p => p.id === id);
        if (produkt) {
            let ilosc = parseInt(nowaIlosc);

            if (isNaN(ilosc) || ilosc <= 0) {
                koszyk = koszyk.filter(p => p.id !== id);
            } else if (ilosc > produkt.maxIlosc) {
                alert(`Możesz zamówić maksymalnie ${produkt.maxIlosc} szt.`);
                produkt.ilosc = produkt.maxIlosc;
            } else {
                produkt.ilosc = ilosc;
            }
        }
        odswiezKoszyk();
    }

    function odswiezKoszyk() {
        let listaGazetkowa = document.getElementById('listaGazetkowa');
        let listaNormalna = document.getElementById('listaNormalna');
        let ukrytePola = document.getElementById('ukrytePola');

        listaGazetkowa.innerHTML = '';
        listaNormalna.innerHTML = '';
        ukrytePola.innerHTML = '';

        let sumaSztuk = 0;
        let sumaCena = 0;

        koszyk.forEach((p, index) => {
            sumaSztuk += p.ilosc;
            sumaCena += (p.cena * p.ilosc);

            let li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center py-2';

            li.innerHTML = `
                <div class="me-auto" style="font-size: 0.85rem;">
                    <div class="fw-bold text-truncate" style="max-width: 140px;" title="${p.nazwa}">${p.nazwa}</div>
                    <div class="text-muted">${p.cena.toFixed(2)} zł/szt</div>
                </div>
                <div class="input-group input-group-sm" style="width: 90px;">
                    <button class="btn btn-outline-secondary" type="button" onclick="zmienIlosc(${p.id}, -1)">-</button>
                    <input type="number" class="form-control text-center fw-bold input-ilosc px-1" value="${p.ilosc}" max="${p.maxIlosc}" onchange="ustawIlosc(${p.id}, this.value)">
                    <button class="btn btn-outline-secondary" type="button" onclick="zmienIlosc(${p.id}, 1)">+</button>
                </div>
            `;

            if (p.czyGazetka) {
                listaGazetkowa.appendChild(li);
            } else {
                listaNormalna.appendChild(li);
            }

            ukrytePola.innerHTML += `
                <input type="hidden" name="produktId[${index}]" value="${p.id}" />
                <input type="hidden" name="ilosc[${index}]" value="${p.ilosc}" />
            `;
        });

        if (koszyk.filter(p => p.czyGazetka).length === 0) listaGazetkowa.innerHTML = '<li class="list-group-item text-muted small py-3 text-center">Brak produktów gazetkowych</li>';
        if (koszyk.filter(p => !p.czyGazetka).length === 0) listaNormalna.innerHTML = '<li class="list-group-item text-muted small py-3 text-center">Brak produktów normalnych</li>';

        document.getElementById('koszykSumaSztuk').innerText = sumaSztuk + ' szt.';
        document.getElementById('koszykSumaCena').innerText = sumaCena.toFixed(2) + ' zł';
        document.getElementById('btnZlozZamowienie').disabled = koszyk.length === 0;
    }

    window.onload = odswiezKoszyk;
</script>