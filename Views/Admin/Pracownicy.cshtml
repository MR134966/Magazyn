@model IEnumerable<Proejkt_magazyn.Models.UserWithRolesViewModel>
@{
    var noweKonto = ViewBag.NoweKonto as Proejkt_magazyn.Models.DodajKontoViewModel ?? new Proejkt_magazyn.Models.DodajKontoViewModel();
    string EtykietaRoli(IList<string> role)
    {
        if (role.Contains("Admin")) return "Administrator";
        if (role.Contains("Kierownik")) return "Kierownik sklepu";
        if (role.Contains("Pracownik")) return "Pracownik magazynu";
        return role.FirstOrDefault() ?? "Brak";
    }
}

<div class="container-fluid mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <h3 class="fw-bold mb-4"><i class="bi bi-people me-2"></i> Konta użytkowników</h3>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold py-3">
            <i class="bi bi-person-plus-fill text-primary me-2"></i> Dodaj nowe konto
        </div>
        <div class="card-body">
            
            <ul class="nav nav-tabs mb-4" id="kontoTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="pracownik-tab" data-bs-toggle="tab" data-bs-target="#pracownik" type="button" role="tab" aria-controls="pracownik" aria-selected="true">
                        <i class="bi bi-box-seam me-1"></i> Pracownik Magazynu
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold text-info" id="kierownik-tab" data-bs-toggle="tab" data-bs-target="#kierownik" type="button" role="tab" aria-controls="kierownik" aria-selected="false">
                        <i class="bi bi-shop me-1"></i> Kierownik Sklepu
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="kontoTabsContent">
                <div class="tab-pane fade show active" id="pracownik" role="tabpanel" aria-labelledby="pracownik-tab">
                    <form asp-controller="Admin" asp-action="DodajKonto" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TypKonta" value="Pracownik" />
                        
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">E-mail (login)</label>
                            <input name="Email" class="form-control" placeholder="jan@magazyn.pl" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Hasło dostępowe</label>
                            <input name="Haslo" type="password" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Numer skanera</label>
                            <input name="NumerSkanera" class="form-control" placeholder="np. SKN-008" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Imię</label>
                            <input name="Imie" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nazwisko</label>
                            <input name="Nazwisko" class="form-control" required />
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-person-plus me-1"></i> Utwórz Pracownika
                            </button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="kierownik" role="tabpanel" aria-labelledby="kierownik-tab">
                    <form asp-controller="Admin" asp-action="DodajKonto" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TypKonta" value="Kierownik" />
                        
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-info">E-mail (login)</label>
                            <input name="Email" class="form-control border-info" placeholder="kierownik@zabka.pl" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-info">Hasło dostępowe</label>
                            <input name="Haslo" type="password" class="form-control border-info" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-info">Przypisany Sklep</label>
                            <input name="Sklep" class="form-control border-info" placeholder="np. Sklep #123" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-info">Imię</label>
                            <input name="Imie" class="form-control border-info" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-info">Nazwisko</label>
                            <input name="Nazwisko" class="form-control border-info" required />
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-info text-white fw-bold shadow-sm">
                                <i class="bi bi-shop-window me-1"></i> Utwórz Kierownika
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>E-mail</th>
                        <th>Imię i nazwisko</th>
                        <th>Przypisanie</th>
                        <th>Typ konta</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var rola = EtykietaRoli(u.Roles);
                        var czyAdmin = u.Roles.Contains("Admin");
                        var czyKierownik = u.Roles.Contains("Kierownik");
                        var przypisanie = czyKierownik
                            ? (string.IsNullOrEmpty(u.User.Sklep) ? "—" : u.User.Sklep)
                            : (string.IsNullOrEmpty(u.User.NumerSkanera) ? "—" : $"Skaner {u.User.NumerSkanera}");
                        <tr class="@(u.CzyZablokowany ? "table-secondary" : "")">
                            <td class="fw-bold">@u.User.Email</td>
                            <td>@u.User.Imie @u.User.Nazwisko</td>
                            <td>@przypisanie</td>
                            <td>
                                @if (czyAdmin)
                                {
                                    <span class="badge bg-danger">@rola</span>
                                }
                                else if (czyKierownik)
                                {
                                    <span class="badge bg-info text-dark">@rola</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@rola</span>
                                }
                            </td>
                            <td>
                                @if (u.CzyZablokowany)
                                {
                                    <span class="badge bg-secondary">Zablokowane</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Aktywne</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (!czyAdmin)
                                {
                                    if (u.CzyZablokowany)
                                    {
                                        <form asp-controller="Admin" asp-action="OdblokujKonto" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.User.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Odblokuj">
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="ZablokujKonto" method="post" class="d-inline block-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.User.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Zablokuj">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    
                                    <form asp-controller="Admin" asp-action="UsunKonto" method="post" class="d-inline ms-1 delete-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.User.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Usuń konto">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal for Blocking -->
<div class="modal fade" id="confirmBlockModal" tabindex="-1" aria-labelledby="confirmBlockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: rgba(30, 34, 40, 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff; border-radius: 16px; box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-warning" id="confirmBlockModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Potwierdzenie blokady
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                Czy na pewno chcesz zablokować to konto? Użytkownik straci możliwość zalogowania się do systemu.
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary btn-sm" style="border-radius: 8px;" data-bs-dismiss="modal">Anuluj</button>
                <button type="button" id="confirmBlockBtn" class="btn btn-warning btn-sm text-dark fw-bold" style="border-radius: 8px;">Zablokuj</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Deleting -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: rgba(30, 34, 40, 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff; border-radius: 16px; box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-danger" id="confirmDeleteModalLabel">
                    <i class="bi bi-trash3-fill me-2"></i>Potwierdzenie usunięcia
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                Czy na pewno chcesz <strong class="text-danger">TRWALE</strong> usunąć to konto? Ta operacja jest nieodwracalna.
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary btn-sm" style="border-radius: 8px;" data-bs-dismiss="modal">Anuluj</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger btn-sm fw-bold" style="border-radius: 8px;">Usuń konto</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    let formToSubmit = null;
    const blockModal = new bootstrap.Modal(document.getElementById('confirmBlockModal'));
    const deleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));

    // Handle block form submissions
    document.querySelectorAll('.block-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            formToSubmit = this;
            blockModal.show();
        });
    });

    // Handle delete form submissions
    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            formToSubmit = this;
            deleteModal.show();
        });
    });

    // Handle confirm clicks
    document.getElementById('confirmBlockBtn').addEventListener('click', function () {
        if (formToSubmit) {
            formToSubmit.submit();
        }
    });

    document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
        if (formToSubmit) {
            formToSubmit.submit();
        }
    });
});
</script>