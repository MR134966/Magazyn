@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Szybki Reset - SmartWMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: radial-gradient(circle at 20% 30%, #1a1e24 0%, #0a0c10 100%);
            color: #ffffff; height: 100vh; display: flex; align-items: center; justify-content: center;
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; position: relative;
        }
        body::before {
            content: ""; position: absolute; inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px; pointer-events: none;
        }
        .login-wrapper { position: relative; z-index: 2; width: 100%; max-width: 440px; animation: fadeInUp 0.7s ease-out; }
        .login-card {
            background: rgba(26, 29, 33, 0.8); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; padding: 50px 40px;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(13, 110, 253, 0.15) inset;
        }
        .brand-logo { font-size: 2.4rem; font-weight: 800; text-align: center; margin-bottom: 20px; color: #3b82f6; letter-spacing: -1px; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .brand-logo span { color: #ffffff; font-weight: 400; }
        .form-label { color: #d1d5db !important; font-size: 0.8rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 8px; text-transform: uppercase; opacity: 0.9; }
        .input-group-text { background-color: rgba(37, 42, 48, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); color: #3b82f6; padding-left: 16px; padding-right: 16px; border-radius: 12px 0 0 12px; border-right: none;}
        .form-control { background-color: rgba(30, 34, 40, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); color: #ffffff; padding: 16px 16px; border-radius: 0 12px 12px 0; font-size: 1rem; border-left: none;}
        .form-control:focus { background-color: rgba(40, 46, 54, 0.8); border-color: #3b82f6; color: #ffffff; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25); outline: none; }
        .form-control::placeholder { color: #9ca3af !important; }
        .btn-login {
            background: linear-gradient(135deg, #2563eb, #1d4ed8); border: none; padding: 16px; font-weight: 700; font-size: 1rem; border-radius: 14px; margin-top: 20px; text-transform: uppercase; letter-spacing: 1px; color: white; transition: all 0.3s ease; box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.5);
        }
        .btn-login:hover { background: linear-gradient(135deg, #3b82f6, #2563eb); transform: translateY(-3px); box-shadow: 0 15px 30px -5px rgba(37, 99, 235, 0.7); }
        .back-link { display: block; text-align: center; margin-top: 25px; color: #9ca3af; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
        .back-link:hover { color: #ffffff; }
        
        .error-box {
            background-color: rgba(220, 53, 69, 0.15);
            border: 1px solid rgba(220, 53, 69, 0.5);
            color: #fca5a5;
            padding: 14px 18px;
            border-radius: 14px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">
        <div class="brand-logo">
            <i class="bi bi-shield-lock-fill me-2"></i>ZMIANA<span>HASŁA</span>
        </div>
        

        @if (TempData["Error"] != null)
        {
            <div class="error-box">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                <div>@TempData["Error"]</div>
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label class="form-label">Twój Adres E-mail</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="nazwa@sklep.pl" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Nowe Hasło</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input type="password" name="noweHaslo" class="form-control" placeholder="Wpisz nowe hasło" required />
                </div>
            </div>

            <button type="submit" class="btn btn-login w-100 shadow">
                <i class="bi bi-check2-circle me-2"></i>Zmień hasło
            </button>
        </form>

        <a asp-controller="Account" asp-action="Login" class="back-link">
            <i class="bi bi-arrow-left me-1"></i> Powrót do logowania
        </a>
    </div>
</div>
</body>
</html>