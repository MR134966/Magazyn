@model Proejkt_magazyn.Models.LoginViewModel

@{
Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logowanie - SmartWMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: radial-gradient(circle at 20% 30%, #1a1e24 0%, #0a0c10 100%);
            color: #ffffff;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            position: relative;
        }

        body::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
        }

        .login-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 440px;
            animation: fadeInUp 0.7s ease-out;
        }

        .login-card {
            background: rgba(26, 29, 33, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 50px 40px;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(13, 110, 253, 0.15) inset;
            transition: transform 0.2s ease;
        }

        .brand-logo {
            font-size: 2.4rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 40px;
            color: #3b82f6;
            letter-spacing: -1px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .brand-logo span {
            color: #ffffff;
            font-weight: 400;
        }

        .form-label {
            color: #d1d5db !important;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 8px;
            text-transform: uppercase;
            opacity: 0.9;
        }

        .input-group {
            position: relative;
        }

        .input-group-text {
            background-color: rgba(37, 42, 48, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #3b82f6;
            padding-left: 16px;
            padding-right: 16px;
            backdrop-filter: blur(5px);
            transition: all 0.3s ease;
        }

        .form-control {
            background-color: rgba(30, 34, 40, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            padding: 16px 16px;
            border-radius: 0 12px 12px 0;
            font-size: 1rem;
            backdrop-filter: blur(5px);
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background-color: rgba(40, 46, 54, 0.8);
            border-color: #3b82f6;
            color: #ffffff;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
            outline: none;
        }

        .form-control::placeholder {
            color: #9ca3af !important;
            opacity: 1;
            font-weight: 400;
        }

        .input-group .form-control {
            border-left: none;
        }

        .input-group .input-group-text {
            border-radius: 12px 0 0 12px;
            border-right: none;
        }

        .btn-login {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: none;
            padding: 16px;
            font-weight: 700;
            font-size: 1rem;
            border-radius: 14px;
            margin-top: 30px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: white;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.5);
            position: relative;
            overflow: hidden;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            transform: translateY(-3px);
            box-shadow: 0 15px 30px -5px rgba(37, 99, 235, 0.7);
        }

        .btn-login:active {
            transform: translateY(1px);
            box-shadow: 0 5px 15px -5px rgba(37, 99, 235, 0.4);
        }

        .error-box {
            background-color: rgba(220, 53, 69, 0.15);
            border: 1px solid rgba(220, 53, 69, 0.5);
            color: #fca5a5;
            padding: 14px 18px;
            border-radius: 14px;
            margin-bottom: 28px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            backdrop-filter: blur(10px);
            animation: shake 0.4s ease-in-out;
        }

        .copyright {
            text-align: center;
            margin-top: 30px;
            color: #6b7280;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        .forgot-password {
            text-align: right;
            margin-top: 8px;
        }

        .forgot-password a {
            color: #9ca3af;
            font-size: 0.8rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .forgot-password a:hover {
            color: #3b82f6;
        }
    </style>
</head>
<body>

<div class="login-wrapper">
    <div class="login-card">
        <div class="brand-logo">
            <i class="bi bi-box-seam-fill me-2"></i>SMART<span>WMS</span>
        </div>

        <form asp-action="Login" method="post">
            @if (TempData["ResetMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: rgba(25, 135, 84, 0.15); border: 1px solid rgba(25, 135, 84, 0.5); color: #86efac; border-radius: 14px;">
                    <i class="bi bi-info-circle-fill me-2"></i> @TempData["ResetMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
            <div class="error-box">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                <div>Niepoprawny e-mail lub hasło</div>
            </div>
            }

            <div class="mb-4">
                <label class="form-label">Adres E-mail</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="nazwa@sklep.pl" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label">Hasło Dostępu</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input asp-for="Haslo" type="password" class="form-control" placeholder="Wprowadź hasło" />
                </div>
                <div class="forgot-password">
                    <a asp-controller="Account" asp-action="ForgotPassword">Zapomniałeś hasła?</a>
                </div>
            </div>

            <button type="submit" class="btn btn-login w-100 shadow">
                <i class="bi bi-box-arrow-in-right me-2"></i>Zaloguj do systemu
            </button>
        </form>

        <div class="copyright">
            © @DateTime.Now.Year SmartWMS
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>