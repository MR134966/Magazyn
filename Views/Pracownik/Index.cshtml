@using Microsoft.AspNetCore.Identity
@inject UserManager<Proejkt_magazyn.Models.ApplicationUser> UserManager
@model Proejkt_magazyn.Services.WynikOptymalizacji
@{
var aktualnyCel = Model.Trasa.FirstOrDefault(p => !p.CzyZebrane);
var ukoczone = !Model.Trasa.Any(p => !p.CzyZebrane);
var user = await UserManager.GetUserAsync(User);
var dystansKm = (user?.DystansDzisiaj ?? 0) / 1000.0;
}

<div class="container-fluid bg-dark p-4 text-light" style="min-height: 100vh;">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2 class="fw-bold m-0"><i class="bi bi-box-seam text-primary me-2"></i>Kompletacja zlecenia</h2>
            <p class="text-muted small mb-0 mt-1">Zamówienie #@ViewBag.ZamowienieId</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-secondary text-info fs-6 px-3 py-2">
                <i class="bi bi-signpost-split me-1"></i> Szacowana trasa: @Model.SzacowanyDystansMetry.ToString("0.0") m
            </span>
        </div>
    </div>

    @if (ukoczone)
    {
    <div class="alert bg-success text-white border-0 shadow-lg mb-4 d-flex align-items-center rounded-4">
        <i class="bi bi-check-circle-fill fs-1 me-4"></i>
        <div class="flex-grow-1">
            <span class="text-uppercase fw-bold opacity-75 d-block" style="letter-spacing: 2px; font-size: 0.8rem;">Zakończono Zbiórkę</span>
            <h2 class="fw-bolder m-0">Wróć do strefy START i zakończ kompletację zamówienia.</h2>
        </div>
    </div>
    }
    else if (aktualnyCel != null)
    {
    <div class="alert bg-warning text-dark border-0 shadow-lg mb-4 d-flex align-items-center rounded-4">
        <i class="bi bi-geo-alt-fill fs-1 me-4 text-danger pulse-box"></i>
        <div class="flex-grow-1">
            <span class="text-uppercase fw-bold opacity-75 d-block" style="letter-spacing: 2px; font-size: 0.8rem;">Zadanie Aktywne</span>
            <h2 class="fw-bolder m-0">Kieruj się do: Aleja @aktualnyCel.Produkt.Aleja, Regał @aktualnyCel.Produkt.Regal</h2>
            <span class="fw-bold text-danger">
                    Pobierz: @aktualnyCel.Produkt.Nazwa (x @aktualnyCel.IloscSztuk)
                @if (aktualnyCel.Produkt.CzyGazetka)
                {
                <span class="badge bg-danger ms-2"><i class="bi bi-tags-fill"></i> GAZETKA</span>
                }
                else
                {
                <span class="badge bg-primary ms-2"><i class="bi bi-box-seam"></i> NORMALNE</span>
                }
                </span>
        </div>
    </div>
    }

    <div class="card bg-dark border-secondary shadow mb-4">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-white fw-bold"><i class="bi bi-map me-2 text-primary"></i>Mapa trasy — najkrótsza droga</span>
            <span class="badge bg-dark border border-secondary text-light">
                <i class="bi bi-person-walking me-1"></i> Dziś: <span class="text-warning">@dystansKm.ToString("0.00") km</span>
            </span>
        </div>
        <div class="card-body p-0 position-relative" style="background: linear-gradient(180deg, #0f1114 0%, #1a1f24 100%); overflow-x: auto;">
            <canvas id="wmsMap" height="520" style="display: block; width: 100%; min-height: 360px;"></canvas>
            <div class="d-flex flex-wrap gap-3 px-3 py-2 border-top border-secondary small text-muted">
                <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#0dcaf0;"></span> Trasa bieżąca</span>
                <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#ffc107;"></span> Cel</span>
                <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#198754;"></span> Zebrane</span>
                <span><span class="d-inline-block rounded me-1" style="width:14px;height:10px;background:#0d6efd;"></span> Strefa START</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @foreach (var poz in Model.Trasa)
            {
            var porada = Model.InstrukcjeDlaTowarow[poz.Id];
            bool toTenTeraz = poz == aktualnyCel;

            <div @(toTenTeraz ? "id=aktywne-zadanie" : "") class="card mb-3 @(poz.CzyZebrane ? "bg-success bg-opacity-10 opacity-75 border-success" : (toTenTeraz ? "bg-white text-dark border-warning border-3" : "bg-dark border-secondary text-light"))">
                <div class="card-body d-flex align-items-center">
                    <div class="me-4 text-center border-end pe-4" style="min-width: 100px;">
                        <h3 class="m-0 fw-bold">@poz.Produkt.Aleja@poz.Produkt.Regal</h3>
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="m-0 fw-bold">
                            @poz.Produkt.Nazwa
                            @if (poz.Produkt.CzyGazetka)
                            {
                            <span class="badge bg-danger ms-2" style="font-size: 0.7rem;"><i class="bi bi-tags-fill"></i> GAZETKA</span>
                            }
                            else
                            {
                            <span class="badge bg-primary ms-2" style="font-size: 0.7rem;"><i class="bi bi-box-seam"></i> NORMALNE</span>
                            }
                        </h5>
                        <div class="mt-1">
                                <span class="badge @(porada.AlertWysokosci ? "bg-warning text-dark" : "bg-secondary")">
                                    @porada.InstrukcjaUlozenia
                                    @if (porada.AlertWysokosci) { <text> · @porada.SprzetDedykowany</text> }
                                </span>
                        </div>
                    </div>

                    <div class="text-end ms-3">
                        <h4 class="fw-bold text-primary m-0 mb-2">x @poz.IloscSztuk</h4>
                        @if (!poz.CzyZebrane && toTenTeraz)
                        {
                        <form asp-action="ZeskanujTowar" method="post" id="formularzSkanowania_@poz.Id">
                            <input type="hidden" name="pozycjaId" value="@poz.Id" />
                            <input type="hidden" name="zamowienieId" value="@ViewBag.ZamowienieId" />
                            <input type="hidden" name="dystansDoDodania" value="@((Math.Abs(5 - poz.Produkt.PozycjaX) + Math.Abs(1 - poz.Produkt.PozycjaY)) * 100)" />
                        </form>

                        <button type="button" class="btn btn-warning btn-lg fw-bold px-4 shadow" onclick="odpalSkaner('@poz.Produkt.KodKreskowy', 'formularzSkanowania_@poz.Id')">
                            <i class="bi bi-upc-scan me-1"></i> Skanuj kod
                        </button>
                        <button type="button" class="btn btn-outline-light ms-2" onclick="document.getElementById('formularzSkanowania_@poz.Id').submit();" title="Potwierdź bez skanera">Potwierdź</button>
                        }
                        else if (poz.CzyZebrane)
                        {
                        <div class="h3 text-success m-0"><i class="bi bi-check-circle-fill"></i></div>
                        }
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="skanerModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning fw-bold"><i class="bi bi-upc-scan"></i> Skanowanie kodu produktu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3">Oczekiwany kod produktu: <strong id="oczekiwanyKodText" class="text-info fs-5"></strong></p>
                <div id="komunikatBledu" class="alert alert-danger d-none fw-bold small py-2"></div>
                <div id="czytnik" class="d-none"></div>
                <div class="text-start p-3 bg-secondary bg-opacity-25 rounded border border-secondary">
                    <label for="skanerZPliku" class="form-label fw-bold mb-2"><i class="bi bi-image me-1"></i> Wybierz zdjęcie z kodem kreskowym:</label>
                    <input class="form-control bg-dark text-light border-secondary form-control-lg" type="file" id="skanerZPliku" accept="image/*">
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    let oczekiwanyEAN = "";
    let aktywnyFormularzId = "";

    function odpalSkaner(kodKreskowy, formularzId) {
        oczekiwanyEAN = kodKreskowy;
        aktywnyFormularzId = formularzId;

        document.getElementById('oczekiwanyKodText').innerText = oczekiwanyEAN;
        document.getElementById('komunikatBledu').classList.add('d-none');
        document.getElementById('skanerZPliku').value = '';

        let skanerModal = new bootstrap.Modal(document.getElementById('skanerModal'));
        skanerModal.show();
    }

    function handleScanSuccess(odczytanyTekst) {
        if(odczytanyTekst === oczekiwanyEAN) {
            bootstrap.Modal.getInstance(document.getElementById('skanerModal')).hide();
            setTimeout(() => {
                document.getElementById(aktywnyFormularzId).submit();
            }, 300);
        } else {
            let errorDiv = document.getElementById('komunikatBledu');
            errorDiv.innerText = `Błąd: Zeskanowano kod ${odczytanyTekst}. Oczekiwano ${oczekiwanyEAN}.`;
            errorDiv.classList.remove('d-none');
        }
    }

    document.getElementById('skanerZPliku').addEventListener('change', function(e) {
        if (e.target.files.length === 0) return;

        const file = e.target.files[0];
        const html5QrCodeFile = new Html5Qrcode("czytnik");

        html5QrCodeFile.scanFile(file, true)
            .then(odczytanyTekst => {
                handleScanSuccess(odczytanyTekst);
            })
            .catch(err => {
                let errorDiv = document.getElementById('komunikatBledu');
                errorDiv.innerText = `Nie udało się odczytać kodu z tego zdjęcia. Upewnij się, że kod jest wyraźny.`;
                errorDiv.classList.remove('d-none');
            });
    });

    window.addEventListener('load', function () {
        const canvas = document.getElementById('wmsMap');
        const ctx = canvas.getContext('2d');
        const parent = canvas.parentElement;
        canvas.width = parent.offsetWidth;
        canvas.height = Math.max(520, Math.min(640, parent.offsetWidth * 0.45));

        const cols = 12;
        const rows = 12;
        const scaleX = canvas.width / cols;
        const scaleY = canvas.height / rows;

        function drawGrid() {
            ctx.strokeStyle = 'rgba(255,255,255,0.06)';
            ctx.lineWidth = 1;
            for (let c = 0; c <= cols; c++) {
                ctx.beginPath();
                ctx.moveTo(c * scaleX, 0);
                ctx.lineTo(c * scaleX, canvas.height);
                ctx.stroke();
            }
            for (let r = 0; r <= rows; r++) {
                ctx.beginPath();
                ctx.moveTo(0, r * scaleY);
                ctx.lineTo(canvas.width, r * scaleY);
                ctx.stroke();
            }
            ctx.fillStyle = 'rgba(13, 202, 240, 0.08)';
            for (let r = 0; r < rows; r += 2) {
                ctx.fillRect(5 * scaleX, r * scaleY, 2 * scaleX, scaleY);
            }
        }
        drawGrid();

        const points = [
            @foreach (var poz in Model.Trasa)
            {
            @:{ x: @poz.Produkt.PozycjaX, y: @poz.Produkt.PozycjaY, label: '@poz.Produkt.Aleja@poz.Produkt.Regal', zebrane: @(poz.CzyZebrane ? "true" : "false") },
            }
        ];

        let nextIndex = points.findIndex(p => !p.zebrane);
        let isReturningToStart = (nextIndex === -1);

        function drawRack(yIndex, label) {
            const y = yIndex * scaleY;
            ctx.fillStyle = 'rgba(73, 80, 87, 0.55)';
            ctx.fillRect(scaleX * 0.2, y + scaleY * 0.08, 4.6 * scaleX, scaleY * 0.84);
            ctx.fillStyle = '#adb5bd';
            ctx.font = '600 11px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(label, 2.5 * scaleX, y + scaleY * 0.58);
        }

        function drawRackRight(yIndex, label) {
            const y = yIndex * scaleY;
            ctx.fillStyle = 'rgba(73, 80, 87, 0.55)';
            ctx.fillRect(7.2 * scaleX, y + scaleY * 0.08, 4.6 * scaleX, scaleY * 0.84);
            ctx.fillStyle = '#adb5bd';
            ctx.font = '600 11px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(label, 9.5 * scaleX, y + scaleY * 0.58);
        }

        drawRack(1, "Spożywcze (L1)");
        drawRack(3, "Kosmetyki (L2)");
        drawRack(5, "Ubrania (L3)");
        drawRack(7, "Meble (L4)");
        drawRack(9, "Magazyn (L5)");

        drawRackRight(1, "Laptopy (P1)");
        drawRackRight(3, "Telefony (P2)");
        drawRackRight(5, "Sport (P3)");
        drawRackRight(7, "Motoryzacja (P4)");
        drawRackRight(9, "AGD / Różne (P5)");

        function aStar(sx, sy, tx, ty) {
            let open = [{x: sx, y: sy, g: 0, f: 0, parent: null}];
            let closed = new Set();
            while(open.length > 0) {
                open.sort((a,b) => a.f - b.f);
                let curr = open.shift();
                let key = curr.x + "," + curr.y;
                if (curr.x === tx && curr.y === ty) {
                    let path = []; let node = curr;
                    while(node) { path.push(node); node = node.parent; }
                    return path.reverse();
                }
                if (closed.has(key)) continue;
                closed.add(key);
                let neighbors = [{x: curr.x+1, y: curr.y}, {x: curr.x-1, y: curr.y}, {x: curr.x, y: curr.y+1}, {x: curr.x, y: curr.y-1}];
                for (let n of neighbors) {
                    let isWalkable = (n.x === 5 || n.x === 6 || n.y % 2 === 0);
                    if (n.x < 0 || n.x >= cols || n.y < 0 || n.y >= rows) isWalkable = false;
                    if (!isWalkable) continue;
                    let nKey = n.x + "," + n.y;
                    if (closed.has(nKey)) continue;
                    let g = curr.g + 1;
                    let h = Math.abs(n.x - tx) + Math.abs(n.y - ty);
                    let existing = open.find(o => o.x === n.x && o.y === n.y);
                    if (existing) {
                        if (g < existing.g) { existing.g = g; existing.f = g + h; existing.parent = curr; }
                    } else { open.push({x: n.x, y: n.y, g: g, f: g+h, parent: curr}); }
                }
            } return [];
        }

        function drawArrowOnSegment(x1, y1, x2, y2) {
            let dx = x2 - x1; let dy = y2 - y1;
            let angle = Math.atan2(dy, dx);
            let mx = x1 + dx/2; let my = y1 + dy/2;
            if(Math.hypot(dx, dy) > 20) {
                ctx.moveTo(mx, my);
                ctx.lineTo(mx - 12 * Math.cos(angle - Math.PI/6), my - 12 * Math.sin(angle - Math.PI/6));
                ctx.moveTo(mx, my);
                ctx.lineTo(mx - 12 * Math.cos(angle + Math.PI/6), my - 12 * Math.sin(angle + Math.PI/6));
                ctx.moveTo(x2, y2);
            }
        }

        let startAisleX, startAisleY, targetAisleX, targetAisleY, targetDotX, targetDotY;

        if (nextIndex === 0) {
            startAisleX = 5; startAisleY = 0;
            targetDotX = points[nextIndex].x; targetDotY = points[nextIndex].y;
            targetAisleX = targetDotX; targetAisleY = targetDotY + 1;
        } else if (nextIndex > 0) {
            let lastCol = nextIndex - 1;
            startAisleX = points[lastCol].x; startAisleY = points[lastCol].y + 1;
            targetDotX = points[nextIndex].x; targetDotY = points[nextIndex].y;
            targetAisleX = targetDotX; targetAisleY = targetDotY + 1;
        } else {
            let lastCol = points.length - 1;
            startAisleX = points[lastCol].x; startAisleY = points[lastCol].y + 1;
            targetDotX = 5; targetDotY = 0;
            targetAisleX = 5; targetAisleY = 0;
        }

        ctx.beginPath();
        ctx.strokeStyle = isReturningToStart ? '#198754' : '#0dcaf0';
        ctx.lineWidth = 5;
        ctx.shadowColor = isReturningToStart ? 'rgba(25, 135, 84, 0.6)' : 'rgba(13, 202, 240, 0.6)';
        ctx.shadowBlur = 15;

        let prevP;
        if (nextIndex === 0) {
            let sx = 6 * scaleX; let sy = scaleY;
            ctx.moveTo(sx, sy); prevP = {x: sx, y: sy};
        } else {
            let idx = isReturningToStart ? points.length - 1 : nextIndex - 1;
            let dotX = points[idx].x * scaleX + scaleX/2;
            let dotY = points[idx].y * scaleY + scaleY/2;
            ctx.moveTo(dotX, dotY);

            let aisleX = startAisleX * scaleX + scaleX/2;
            let aisleY = startAisleY * scaleY + scaleY/2;
            ctx.lineTo(aisleX, aisleY);
            drawArrowOnSegment(dotX, dotY, aisleX, aisleY);
            prevP = {x: aisleX, y: aisleY};
        }

        let path = aStar(startAisleX, startAisleY, targetAisleX, targetAisleY);
        for(let j=1; j<path.length; j++) {
            let nx = path[j].x * scaleX + scaleX/2;
            let ny = path[j].y * scaleY + scaleY/2;
            ctx.lineTo(nx, ny);
            drawArrowOnSegment(prevP.x, prevP.y, nx, ny);
            prevP = {x: nx, y: ny};
        }

        let finalX = isReturningToStart ? 6 * scaleX : targetDotX * scaleX + scaleX/2;
        let finalY = isReturningToStart ? scaleY : targetDotY * scaleY + scaleY/2;
        ctx.lineTo(finalX, finalY);
        drawArrowOnSegment(prevP.x, prevP.y, finalX, finalY);

        ctx.stroke();
        ctx.shadowBlur = 0;

        if (isReturningToStart) {
            ctx.fillStyle = '#198754';
            ctx.shadowColor = '#198754';
            ctx.shadowBlur = 20;
        } else {
            ctx.fillStyle = '#0dcaf0';
            ctx.shadowBlur = 0;
        }
        ctx.fillRect(5 * scaleX, 0, 2 * scaleX, scaleY);
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#fff';
        ctx.textAlign = 'center';
        ctx.font = 'bold 13px Inter, sans-serif';
        ctx.fillText(isReturningToStart ? 'KONIEC' : 'START', 6 * scaleX, scaleY * 0.62);

        points.forEach((p, index) => {
            const px = p.x * scaleX + scaleX/2;
            const py = p.y * scaleY + scaleY/2;
            ctx.beginPath();
            ctx.arc(px, py, 15, 0, 2 * Math.PI);

            if (p.zebrane) {
                ctx.fillStyle = '#198754';
                ctx.fill();
                ctx.fillStyle = '#fff';
                ctx.font = 'bold 14px sans-serif';
                ctx.fillText('✓', px, py + 5);
            } else if (index === nextIndex) {
                ctx.fillStyle = '#ffc107';
                ctx.shadowColor = '#ffc107';
                ctx.shadowBlur = 15;
                ctx.fill();
            } else {
                ctx.fillStyle = '#4a5056';
                ctx.fill();
            }
            ctx.shadowBlur = 0;
            ctx.strokeStyle = '#121416';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.fillStyle = '#fff';
            ctx.font = 'bold 11px sans-serif';
            ctx.fillText(p.label, px, py - 22);
        });

        const aktywneZadanie = document.getElementById('aktywne-zadanie');
        if (aktywneZadanie) {
            setTimeout(() => {
                aktywneZadanie.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 2000);
        }
    });
</script>