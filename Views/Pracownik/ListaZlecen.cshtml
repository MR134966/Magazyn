@model IEnumerable<Proejkt_magazyn.Models.Zamowienie>

<div class="container">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="fw-bold m-0"><i class="bi bi-clipboard2-data text-primary me-2"></i>Lista zleceń</h1>
            <p class="text-muted mb-0">Wybierz zamówienie, aby rozpocząć kompletację</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var z in Model)
        {
            var isFinished = z.Pozycje.All(p => p.CzyZebrane) && z.Pozycje.Any();
            var progress = z.Pozycje.Count > 0 ? (z.Pozycje.Count(p => p.CzyZebrane) * 100) / z.Pozycje.Count : 0;

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 transition-hover" style="border-radius: 15px; overflow: hidden;">
                    <div class="card-header @(isFinished ? "bg-success" : "bg-primary") text-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="m-0 fw-bold">Zlecenie #@z.Id</h5>
                            <i class="bi @(isFinished ? "bi-check-all" : "bi-hourglass-split") fs-4"></i>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-muted small fw-bold mb-3">Odbiorca</h6>
                        <h4 class="fw-bold mb-4">@z.NazwaKlienta</h4>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Postęp prac</span>
                            <span class="small fw-bold">@progress%</span>
                        </div>
                        <div class="progress mb-4" style="height: 8px; border-radius: 4px;">
                            <div class="progress-bar @(isFinished ? "bg-success" : "bg-primary") progress-bar-striped progress-bar-animated" 
                                 style="width: @progress%"></div>
                        </div>

                        <div class="row text-center mb-4">
                            <div class="col-6 border-end">
                                <div class="h4 m-0 fw-bold">@z.Pozycje.Count</div>
                                <div class="small text-muted text-uppercase" style="font-size: 0.6rem;">Towarów</div>
                            </div>
                            <div class="col-6">
                                <div class="h4 m-0 fw-bold text-primary">@z.Pozycje.Sum(p => p.IloscSztuk)</div>
                                <div class="small text-muted text-uppercase" style="font-size: 0.6rem;">Sztuk</div>
                            </div>
                        </div>

                        <a asp-action="Index" asp-route-id="@z.Id" 
                           class="btn @(isFinished ? "btn-outline-success" : "btn-primary") w-100 py-2 fw-bold rounded-pill shadow-sm">
                            @if(isFinished) { <text><i class="bi bi-eye me-2"></i>Podgląd</text> } 
                            else { <text><i class="bi bi-play-fill me-2"></i>Rozpocznij picking</text> }
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover { transition: transform 0.2s ease-in-out, shadow 0.2s; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; }
</style>